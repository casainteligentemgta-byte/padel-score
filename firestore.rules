rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Usamos getAfter para permitir que las reglas funcionen incluso si el documento se está creando/actualizando en la misma transacción (aunque get es suficiente aquí)
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        request.auth.token.email == 'admin@padelscore.pro'
      );
    }

    function isMarker() {
      return isAuthenticated() && (getUserData().role == 'marker' || isAdmin());
    }
    
    function isTournamentOwner(tournamentData) {
      return isAuthenticated() && (
        request.auth.uid == tournamentData.ownerId || 
        request.auth.uid == tournamentData.createdBy ||
        (tournamentData.owners != null && (
          request.auth.uid in tournamentData.owners || 
          request.auth.token.email in tournamentData.owners
        ))
      );
    }

    // ==========================================
    // COLLECTIONS
    // ==========================================

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isMarker());
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (!request.resource.data.keys().hasAny(['role', 'markerCanchas']) || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'markerCanchas']))
      );
      allow delete: if isAdmin();
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin(); // Solo admins crean torneos base
      allow update, delete: if isAdmin() || isTournamentOwner(resource.data);

      match /matches/{matchId} {
        allow read: if true;
        // Solo admins, dueños o marcadores pueden escribir.
        // TODO: Validar que el marcador esté asignado a esta cancha específica.
        allow write: if isAdmin() || isTournamentOwner(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data) || isMarker();
      }
    }

    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /participants/{participantId} {
      allow read: if true; 
      // Los usuarios solo pueden crear/editar sus propios perfiles de participante
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }

    // Inscriptions
    match /inscriptions/{inscriptionId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.ownerId == request.auth.uid &&
          (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'pending')
        )
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'amountExtracted', 'tournamentId']))
      );
      allow delete: if isAdmin();
    }

    // Financial Data
    match /expenses/{expenseId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.ownerId);
      allow write: if isAdmin() || (isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid));
    }

    // Ads
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings
    match /admin/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Catch-all
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
