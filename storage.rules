rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicidad: lectura pública, escritura solo autenticados
    match /publicidad/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // El resto: solo autenticados
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
