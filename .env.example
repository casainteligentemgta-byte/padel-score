# ============================================
# PADEL SCORE — Variables de entorno (copiar a .env.local y rellenar)
# ============================================
# Ver también: VERCEL_Y_SUPABASE.md para login en Vercel.

# --- Obligatorias para login y APIs (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Storage: subida de logos de patrocinantes, comprobantes, etc. ---
# Nombre del bucket que creaste en Supabase → Storage (debe existir y ser público).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=patrocinantes

# URL pública de la app; QR Express, WhatsApp, emails. Producción: smartpadel58.com
# NEXT_PUBLIC_APP_URL=https://smartpadel58.com
# Staging (padel-score-mgti): NEXT_PUBLIC_APP_URL=https://padel-score-mgti.vercel.app
# Local (QR Express apunta a localhost): NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tier de despliegue Vercel: production (padel-score) | staging (padel-score-mgti)
# PADEL_DEPLOYMENT_TIER=production

# --- Express TV: activación por PIN (opcional) ---
# Si es 1, la TV pide PIN antes de mostrar la pizarra (/api/tv/init + /api/tv/verify).
# NEXT_PUBLIC_EXPRESS_TV_AUTH=1

# --- Telegram: PIN de pantallas + bot staff (/login CODIGO) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=SmartPadelBot   # Sin @; se muestra en admin staff al vincular
# TELEGRAM_CHAT_ID=   # Tu chat ID: PIN, /urls, login staff y informe 23:59 VE
# Webhook producción: POST https://tu-dominio.com/api/telegram/webhook

# Cron Vercel: informe diario Express 23:59 (America/Caracas) → schedule UTC 03:59
# CRON_SECRET=        # Vercel lo envía como Authorization: Bearer …
# EXPRESS_REPORT_TIMEZONE=America/Caracas

# Número interno para avisos admin por WhatsApp (Twilio); E.164 sin espacios, ej. 584122117270. Por defecto 584122117270.
# ADMIN_ALERT_WHATSAPP=584122117270

# Opcional: WhatsApp al CEO cuando el torneo alcanza 16 jugadores con pago aprobado (cupo lleno). Si no se define, se usa ADMIN_ALERT_WHATSAPP.
# CEO_ALERT_WHATSAPP=584122117270

# --- Soporte (WhatsApp en PaymentInfo; sin +, ej. 584122117270) ---
# NEXT_PUBLIC_SUPPORT_WHATSAPP=584122117270

# Twilio (servidor). Requerido para envío de WhatsApp desde API routes.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Tasa BCV (bolívares por 1 USD) para validar comprobantes Bs. vs precio USD (opcional) ---
# Si no se define, /api/fx/bcv intenta https://ve.dolarapi.com/v1/dolares/oficial
# BCV_VES_PER_USD=56.70

# --- Admins extra (opcional) ---
# Emails separados por coma. Coincidencia exacta (no por dominio).
# El rol admin en `profiles` tiene prioridad; esta lista es un extra.
# NEXT_PUBLIC_ADMIN_EMAILS=owner@example.com
# ADMIN_EMAILS=owner@example.com   # alternativa solo servidor (no llega al bundle)

# Destino de avisos (nuevo jugador / inscripción). Si falta, /api/send-email responde 501.
# ADMIN_NOTIFY_EMAIL=owner@example.com

# --- Simulación / desarrollo (opcional) ---
# SOLO local (NODE_ENV=development). NO definir en Vercel producción:
# van al bundle del cliente y el botón sandbox queda inerte en prod de todos modos.
# NEXT_PUBLIC_DEV_EMAIL=
# NEXT_PUBLIC_DEV_PASSWORD=

# --- IA / Agentes (opcional) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Póster (Nano Banana 2 / NanoPhoto.AI) — admin Generador Maestro ---
# Clave de https://nanophoto.ai (Bearer). Sin esto, el póster usa fallback canvas.
# NANOPHOTO_API_KEY=
# NANO_BANANA2_API_KEY=   # alias aceptado por el código
# NANOPHOTO_API_BASE_URL=https://nanophoto.ai

# --- Firebase RTDB (opcional, solo fan-out de marcador/publicidad) ---
# El origen de verdad es Supabase. Si no se definen, la app funciona igual.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Mercado Pago ---
# MERCADOPAGO_ACCESS_TOKEN=
# Secreto HMAC del webhook (Tus integraciones → Webhooks). Obligatorio: sin esto el webhook responde 401.
# MERCADOPAGO_WEBHOOK_SECRET=

# --- Webhooks / crons (cabecera Authorization: Bearer … o x-webhook-secret) ---
# TELEGRAM_WEBHOOK_SECRET=          # También X-Telegram-Bot-Api-Secret-Token al registrar el webhook
# SMARTPADEL_CEO_WEBHOOK_SECRET=    # Webhook Supabase → /api/v1/smartpadel-ceo/webhook
# WEBHOOK_SECRET=                   # Alternativa aceptada por el webhook CEO
# CRON_SECRET=                      # Vercel Cron (Authorization: Bearer …)
# SUPABASE_SERVICE_ROLE_KEY=        # Rutas de servidor (nunca en el cliente)
# LEGAL_BULK_EMAIL_SECRET=
