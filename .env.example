# ============================================
# PADEL SCORE — Variables de entorno (copiar a .env.local y rellenar)
# ============================================
# Ver también: VERCEL_Y_SUPABASE.md para login en Vercel.

# --- Obligatorias para login y APIs (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Storage: subida de logos de patrocinantes, comprobantes, etc. ---
# Nombre del bucket que creaste en Supabase → Storage (debe existir y ser público).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=patrocinantes

# URL pública de la app (Vercel o dominio); usada en enlaces de WhatsApp (accept-invite, confirmar-pareja, etc.)
# NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app

# Número interno para avisos admin por WhatsApp (Twilio); E.164 sin espacios, ej. 584122117270. Por defecto 584122117270.
# ADMIN_ALERT_WHATSAPP=584122117270

# Opcional: WhatsApp al CEO cuando el torneo alcanza 16 jugadores con pago aprobado (cupo lleno). Si no se define, se usa ADMIN_ALERT_WHATSAPP.
# CEO_ALERT_WHATSAPP=584122117270

# --- Soporte (WhatsApp en PaymentInfo; sin +, ej. 584122117270) ---
# NEXT_PUBLIC_SUPPORT_WHATSAPP=584122117270

# Twilio (servidor). Requerido para envío de WhatsApp desde API routes.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Tasa BCV (bolívares por 1 USD) para validar comprobantes Bs. vs precio USD (opcional) ---
# Si no se define, /api/fx/bcv intenta https://ve.dolarapi.com/v1/dolares/oficial
# BCV_VES_PER_USD=56.70

# --- Simulación / desarrollo (opcional) ---
# Si están definidas, "Simulación de Ingreso Rápido" inicia sesión con este usuario.
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=

# --- IA / Agentes (opcional) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Póster (Nano Banana 2 / NanoPhoto.AI) — admin Generador Maestro ---
# Clave de https://nanophoto.ai (Bearer). Sin esto, el póster usa fallback canvas.
# NANOPHOTO_API_KEY=
# NANO_BANANA2_API_KEY=   # alias aceptado por el código
# NANOPHOTO_API_BASE_URL=https://nanophoto.ai

# --- Prisma / PostgreSQL (opcional) ---
# Algunas rutas de API (tournaments, matches) usan Prisma. Sin esto, la API de torneos puede responder en modo demo.
DATABASE_URL=postgresql://user:pass@host:5432/db
DIRECT_URL=postgresql://user:pass@host:5432/db

# --- Firebase (opcional) ---
# Solo si usas display, marker, RTDB o storage. El login ya no depende de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin (servidor). Solo si quieres proteger APIs con token Firebase (por defecto se usa Supabase).
# FIREBASE_SERVICE_ACCOUNT_KEY=
