# ============================================
# PADEL SCORE PRO - Ejemplo de variables (copiar a .env.local y rellenar)
# ============================================

# IA
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Firebase (cliente)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor) — necesario para que las APIs exijan login
# Obtener: Firebase Console → Configuración → Cuentas de servicio → Generar nueva clave
# Pegar aquí el JSON completo (una sola línea o con escapes)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Simulación (opcional): si están definidas, "Entrada Rápida / Modo Simulación" inicia sesión real
# y podrás guardar torneos desde la simulación. Usa el mismo email/contraseña de un usuario en Firebase Auth.
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=
