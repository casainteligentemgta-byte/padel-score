# ============================================
# PADEL SCORE — Variables de entorno (copiar a .env.local y rellenar)
# ============================================
# Ver también: VERCEL_Y_SUPABASE.md para login en Vercel.

# --- Obligatorias para login y APIs (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Storage: subida de logos de patrocinantes, comprobantes, etc. ---
# Nombre del bucket que creaste en Supabase → Storage (debe existir y ser público).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=patrocinantes

# --- Soporte (WhatsApp en PaymentInfo; sin +, ej. 584122117270) ---
# NEXT_PUBLIC_SUPPORT_WHATSAPP=584122117270

# --- Simulación / desarrollo (opcional) ---
# Si están definidas, "Simulación de Ingreso Rápido" inicia sesión con este usuario.
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=

# --- IA / Agentes (opcional) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Prisma / PostgreSQL (opcional) ---
# Algunas rutas de API (tournaments, matches) usan Prisma. Sin esto, la API de torneos puede responder en modo demo.
DATABASE_URL=postgresql://user:pass@host:5432/db
DIRECT_URL=postgresql://user:pass@host:5432/db

# --- Firebase (opcional) ---
# Solo si usas display, marker, RTDB o storage. El login ya no depende de Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin (servidor). Solo si quieres proteger APIs con token Firebase (por defecto se usa Supabase).
# FIREBASE_SERVICE_ACCOUNT_KEY=
